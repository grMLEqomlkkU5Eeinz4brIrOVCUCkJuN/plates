# Loaded by `npm run dev` via `node --env-file-if-exists=.env.development`.
# Committed on purpose: the secrets below are throwaway dev values, long
# enough to clear the 32-character floor in src/config/env.ts and nothing more.
# Never reuse them anywhere real.

NODE_ENV=development
PORT=3000

# Logging
LOG_LEVEL=debug
SERVICE_NAME=jwt-backend
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=false

# CORS - credentials on, so the origin cannot be a wildcard.
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# JWT - dev throwaways (min 32 chars)
JWT_SECRET=dev-jwt-secret-not-for-production-00
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-not-for-prod0
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookies - dev throwaway secret (min 32 chars). http://localhost is a secure
# context, so COOKIE_SECURE=false is only needed for non-localhost dev hosts.
COOKIE_SECRET=dev-cookie-secret-not-for-production
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Leave unset on localhost and wherever one host serves everything.
COOKIE_DOMAIN=

# CSRF - dev throwaway secret (min 32 chars)
CSRF_SECRET=dev-csrf-secret-not-for-production-0
