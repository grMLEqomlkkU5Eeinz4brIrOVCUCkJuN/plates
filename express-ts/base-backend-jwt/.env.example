# Server
NODE_ENV=development
PORT=3000

# Logging
LOG_LEVEL=info
SERVICE_NAME=jwt-backend
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=true

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT (generate secure random strings for production)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookies
COOKIE_SECRET=your-super-secret-cookie-key-min-32
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CSRF
CSRF_SECRET=your-super-secret-csrf-key-min-32-ch
