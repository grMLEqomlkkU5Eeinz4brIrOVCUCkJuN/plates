# Copy to `.env.production` and fill in. `npm start` loads it via
# `node --env-file-if-exists=.env.production`. `.env.production` is gitignored.
#
# Prefer injecting these as real environment variables where you can; when a
# key is set in both the environment and this file, the environment wins.

NODE_ENV=production
PORT=3000

# Logging
LOG_LEVEL=info
SERVICE_NAME=jwt-prisma-backend
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=true

# Database. Migrations are applied with `npm run db:deploy` (prisma migrate
# deploy) as a separate step before the new version starts serving - the app
# does not migrate on boot, and two replicas racing to do so is the reason why.
# DATABASE_POOL_MAX is per process: multiply it by your replica count and keep
# the total under Postgres' max_connections, or put PgBouncer in between.
DATABASE_URL=postgresql://user:password@db.example.com:5432/appdb?schema=public&sslmode=require
DATABASE_POOL_MAX=10

# CORS - name the origins you serve. A wildcard cannot be combined with
# credentials; config/env.ts refuses to start on that pairing.
CORS_ORIGIN=https://app.example.com
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT - generate random values, at least 32 characters each, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookies
COOKIE_SECRET=
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
# Which hosts the browser sends the session and CSRF cookies back to. Empty
# leaves them host-only. Set the shared parent (example.com) when more than one
# of your hosts has to see the session; middleware/csrf.ts binds each CSRF
# token to the access-token cookie, so the two need the same scope.
COOKIE_DOMAIN=

# CSRF
CSRF_SECRET=
