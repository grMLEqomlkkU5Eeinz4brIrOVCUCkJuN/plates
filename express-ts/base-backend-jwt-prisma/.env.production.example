# Copy to `.env.production` and fill in. `npm start` loads it via
# `node --env-file-if-exists=.env.production`; `NODE_ENV=production npm run
# db:deploy` reads it too. `.env.production` is gitignored.
#
# Prefer injecting these as real environment variables where you can; when a
# key is set in both the environment and this file, the environment wins.
# Everything with a default in src/config/env.ts is listed here anyway, so the
# whole contract is in one place.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 'http' includes the access log, which carries the request ids everything
# else correlates on; 'info' and above drop it.
LOG_LEVEL=http
# Resolved from the working directory. In a container, mount a volume here or
# drop the file transports in src/utils/logger.ts and ship stdout instead.
LOG_DIR=logs
SERVICE_NAME=jwt-prisma-backend
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=true

# Migrations are applied with `npm run db:deploy` (prisma migrate deploy) as a
# separate step before the new version starts serving. The app does not
# migrate on boot, and two replicas racing to do so is the reason why.
DATABASE_URL=postgresql://user:password@db.example.com:5432/appdb?sslmode=require
# Per process: replicas x DATABASE_POOL_MAX, plus a human with psql, has to
# stay under Postgres' max_connections (100 by default), or put PgBouncer in
# between.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# The number of proxies in front of this process, or their addresses. `true`
# is refused in production: it lets any client forge the address the rate
# limiter keys on.
TRUST_PROXY=1
JSON_BODY_LIMIT=64kb
# Under the grace period of whatever stops the process (Kubernetes: 30s).
SHUTDOWN_TIMEOUT_MS=10000

# Name the origins you serve. A wildcard cannot be combined with credentials;
# config/env.ts refuses to start on that pairing.
CORS_ORIGIN=https://app.example.com
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Applied to register, login, refresh and account deletion, per address and
# per email. In-process only: see the caveat in src/middleware/rateLimit.ts
# before running more than one replica.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# argon2id cost. These are the OWASP minimums; raise them if the box can afford it.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
# Which hosts the browser sends the session and CSRF cookies back to. Empty
# leaves them host-only. Set the shared parent (example.com) when more than one
# of your hosts has to see the session; middleware/csrf.ts binds each CSRF
# token to the access-token cookie, so the two need the same scope.
COOKIE_DOMAIN=

# Generate with: openssl rand -base64 48
CSRF_SECRET=
