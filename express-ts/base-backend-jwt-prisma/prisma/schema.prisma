// The datasource URL lives in prisma.config.ts, not here: Prisma 7 reads
// connection details from the config file, and the schema only describes shape.
//
// Run `npm run db:migrate` after editing a model - the generated client under
// src/generated/prisma is what the rest of the app imports, and it is only
// rewritten by `prisma generate` (which `npm install` and `db:migrate` both run).

generator client {
	provider = "prisma-client"
	output   = "../src/generated/prisma"
	runtime  = "nodejs"
	// The project compiles to CommonJS (no "type": "module" in package.json,
	// `module: nodenext` in tsconfig). An ESM client in a CommonJS app fails at
	// require time with ERR_REQUIRE_ESM, so the two have to agree.
	moduleFormat = "cjs"
}

datasource db {
	provider = "postgresql"
}

model User {
	id           String   @id @default(uuid()) @db.Uuid
	email        String   @unique
	name         String
	// argon2id. Never selected into a response; models/user.model.ts is the
	// only place a row becomes a body, and it does not copy this field.
	passwordHash String   @map("password_hash")
	createdAt    DateTime @default(now()) @map("created_at")
	updatedAt    DateTime @updatedAt @map("updated_at")

	refreshTokens RefreshToken[]

	@@map("users")
}

// One row per refresh token ever issued. A login opens a family; each refresh
// spends the current token (usedAt) and adds the next one to the same family;
// logout revokes the whole family. The token itself is never stored, only its
// SHA-256, so a leaked table cannot be replayed.
model RefreshToken {
	id        String    @id @default(uuid()) @db.Uuid
	userId    String    @map("user_id") @db.Uuid
	familyId  String    @map("family_id") @db.Uuid
	tokenHash String    @unique @map("token_hash")
	expiresAt DateTime  @map("expires_at")
	usedAt    DateTime? @map("used_at")
	revokedAt DateTime? @map("revoked_at")
	createdAt DateTime  @default(now()) @map("created_at")

	user User @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@index([familyId])
	@@index([userId])
	@@map("refresh_tokens")
}
