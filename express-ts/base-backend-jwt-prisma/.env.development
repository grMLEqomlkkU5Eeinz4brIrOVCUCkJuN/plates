# Loaded by `npm run dev` via `node --env-file-if-exists=.env.development`, and
# by the Prisma CLI through prisma.config.ts. Committed, because the secrets
# below are throwaway dev values, long enough to clear the 32-character floor
# in src/config/env.ts and nothing more. Never reuse them anywhere real.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 'http' includes the access log; 'info' and above drop it.
LOG_LEVEL=http
LOG_DIR=logs
SERVICE_NAME=jwt-prisma-backend
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=false

# Matches the Postgres in docker-compose.yml (`docker compose up -d db`). The
# pool settings have defaults in src/config/env.ts; name them here when the
# numbers need to move.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jwt_prisma_backend
DATABASE_POOL_MAX=10

# 'false' when the process is exposed directly, otherwise the number of proxy
# hops in front of it, or the proxy addresses. req.ip comes from this, and the
# rate limiter keys on req.ip.
TRUST_PROXY=false

# Credentials on, so the origin cannot be a wildcard.
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Generous for development; the production example is 5 per 15 minutes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Dev throwaway (min 32 chars). The refresh token is an opaque database row,
# so there is no second secret.
JWT_SECRET=dev-jwt-secret-not-for-production-00
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# http://localhost is a secure context, so COOKIE_SECURE=false is only needed
# for non-localhost dev hosts.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Leave unset on localhost and wherever one host serves everything.
COOKIE_DOMAIN=

CSRF_SECRET=dev-csrf-secret-not-for-production-0
