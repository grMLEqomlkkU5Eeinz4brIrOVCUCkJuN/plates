# The environment the jest suite runs against. Loaded by src/test/env.ts before
# any module that reads the environment is imported.
#
# None of this is secret and none of it is shared with another environment. It
# exists so config/env.ts, which refuses to boot on a missing value, has a
# complete contract in a test process. process.loadEnvFile does not overwrite a
# variable that is already set, so the shell still wins: DATABASE_URL=... npm
# test points the suite at a different database.

NODE_ENV=test

# The second database docker-compose.yml creates (scripts/create-test-database.sql).
# The suite truncates tables between tests, so it must never be the one you
# are developing against.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jwt_prisma_backend_test

TRUST_PROXY=false

JWT_SECRET=test-jwt-secret-that-is-long-enough-32-chars
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

CSRF_SECRET=test-csrf-secret-that-is-long-enough-32-chars

# supertest speaks plain HTTP and sets the Cookie header by hand, so neither
# flag is exercised; these are the localhost values from .env.development.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Deliberately below the OWASP floor: every register and login in the suite
# pays this cost, and 19 MiB per hash turns a test run into a coffee break.
ARGON2_MEMORY_KIB=1024
ARGON2_TIME_COST=1

# Small, so the limit test trips it in a handful of requests.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
