# Loaded by `npm run dev` via `node --env-file-if-exists=.env.development`.
# Committed on purpose: the secrets below are random dev-only values that pass
# lacewing's entropy check, so `npm run dev` works straight after `npm install`.
# They are public - regenerate with `npm run secrets` before using them anywhere.

NODE_ENV=development
PORT=3000

# Logging
LOG_LEVEL=debug
SERVICE_NAME=lacewing-backend
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=false

# CORS - credentials on, so the origin cannot be a wildcard.
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# JWT - dev-only random values. Access expiry is capped at 1h by lacewing.
JWT_SECRET=3hebTtx7uQiMI2r4AmEk1lYeEfnVvtgt-S181E1HeEs
JWT_REFRESH_SECRET=AaJOxWukpyvXf1-6JfNbHjbVUmlpjevTb6Q3bT80j6I
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000/api/v1

# Cookies - every cookie is HttpOnly; Secure unconditionally. http://localhost
# counts as a secure context, so dev works. "none" is not an accepted SameSite.
COOKIE_SECRET=ZIdxPxvkhFrQVhNNk0K-kFgRbSUl3hSvI8aHRju-iiw
COOKIE_SAME_SITE=lax
# Leave unset on localhost and wherever one host serves everything.
COOKIE_DOMAIN=

# CSRF
CSRF_SECRET=esX8Qhn_6JHWa2tZaCUsV6sQJF3oAZgfhnQz7jc8oss
