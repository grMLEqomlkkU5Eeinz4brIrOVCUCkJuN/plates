# Server
NODE_ENV=development
PORT=3000

# Logging
LOG_LEVEL=info
SERVICE_NAME=lacewing-backend
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=true

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Secrets - run `npm run secrets` and paste its output over these four lines.
# Placeholders will not work: lacewing entropy-checks the JWT secrets at boot
# and refuses anything that looks like a human-chosen password.
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
CSRF_SECRET=

# JWT claims. Verification pins both - a token minted for another issuer or
# audience is rejected regardless of its signature.
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000/api/v1
# Access expiry is capped at 1h by lacewing; that cap is the point.
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookies. No COOKIE_SECURE switch: every cookie is HttpOnly; Secure,
# unconditionally (http://localhost counts as a secure context). "none" is
# not an accepted SameSite value.
COOKIE_SAME_SITE=lax
# Which hosts the browser sends the session and CSRF cookies back to. Empty
# leaves them host-only: only the host that set them gets them back, which is
# right on localhost and behind a single hostname.
#
# Set the shared parent (example.com) when the browser has to reach more than
# one of your hosts, say a frontend on app.example.com calling this API on
# api.example.com. Without it the session and its CSRF token never arrive at
# the requests they authorise. A Domain cookie also goes to every subdomain
# under it, including ones you do not run, so name the narrowest parent that
# covers your hosts.
COOKIE_DOMAIN=
