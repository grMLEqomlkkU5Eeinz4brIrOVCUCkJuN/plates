# Copy to `.env.production` and fill in. `npm start` loads it via
# `node --env-file-if-exists=.env.production`. `.env.production` is gitignored.
#
# Prefer injecting these as real environment variables where you can; when a
# key is set in both the environment and this file, the environment wins.

NODE_ENV=production
PORT=3000

# Logging
LOG_LEVEL=info
SERVICE_NAME=lacewing-backend
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=true

# CORS - name the origins you serve. A wildcard cannot be combined with
# credentials; config/env.ts refuses to start on that pairing.
CORS_ORIGIN=https://app.example.com
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT - run `npm run secrets` for values that pass lacewing's entropy check.
# A human-chosen passphrase is refused at boot even when it is long enough.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Verification pins both - a token minted for another issuer or audience is
# rejected regardless of its signature.
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=https://api.example.com/api/v1

# Cookies - "none" is not an accepted SameSite value here.
COOKIE_SECRET=
COOKIE_SAME_SITE=strict
# Which hosts the browser sends the session and CSRF cookies back to. Empty
# leaves them host-only. Set the narrowest shared parent (example.com) when the
# browser has to reach more than one of your hosts; without it the session and
# its CSRF cookie never arrive and the failure reads as a 401 or a CSRF reject.
COOKIE_DOMAIN=

# CSRF
CSRF_SECRET=
