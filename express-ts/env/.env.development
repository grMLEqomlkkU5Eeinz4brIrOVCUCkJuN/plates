# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
SERVICE_NAME=damocles
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=false

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# JWT (min 32 characters)
JWT_SECRET=dev-jwt-secret-change-me-in-prod-00
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me-00
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookies (min 32 characters)
COOKIE_SECRET=dev-cookie-secret-change-me-in-prod
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CSRF (min 32 characters)
CSRF_SECRET=dev-csrf-secret-change-me-in-prod-0
