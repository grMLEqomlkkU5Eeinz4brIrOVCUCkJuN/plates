# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=damocles
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=true

# CORS
# A wildcard origin cannot be combined with credentials - browsers reject the
# pairing, and config/env.ts refuses to start on it. Name your origins (comma
# separated) if you need cookies to travel.
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT (min 32 characters)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookies (min 32 characters)
COOKIE_SECRET=
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# CSRF (min 32 characters)
CSRF_SECRET=
