# Copy to `.env.production` and fill in. `npm start` loads it via
# `node --env-file-if-exists=.env.production`. `.env.production` is gitignored.
#
# In a real deployment, prefer injecting these as real environment variables;
# when a key is set in both the environment and this file, the environment wins.

NODE_ENV=production
PORT=3000

# Logging
LOG_LEVEL=info
SERVICE_NAME=base-backend
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=true

# CORS - name the origins you serve. A wildcard cannot be combined with
# credentials; config/env.ts refuses to start on that pairing.
CORS_ORIGIN=https://example.com
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
