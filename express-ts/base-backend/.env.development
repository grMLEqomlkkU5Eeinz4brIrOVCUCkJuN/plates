# Loaded by `npm run dev` via `node --env-file-if-exists=.env.development`.
# Committed on purpose: nothing here is secret, and every key also has a
# default in src/config/env.ts, so `npm run dev` works without this file too.

NODE_ENV=development
PORT=3000

# Logging
LOG_LEVEL=debug
SERVICE_NAME=base-backend
MAX_LOG_SIZE=20m
MAX_LOG_FILES=14d
COMPRESS_LOGS=false

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
