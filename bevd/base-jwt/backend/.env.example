# Bun loads this file automatically when it is named `.env`:
#   cp .env.example .env

NODE_ENV=development
# Elysia serves REST + tRPC here.
PORT=3000
# The gRPC server listens separately - gRPC needs HTTP/2, Elysia speaks HTTP/1.1.
GRPC_PORT=50051

# debug | info | warn | error | silent
# Pretty-printed while NODE_ENV=development, NDJSON otherwise (what a log shipper wants).
LOG_LEVEL=info
# Tags every log line, so one stream can carry more than one service.
SERVICE_NAME=bevd-jwt-backend

# Matches the credentials in ../docker-compose.yml
DATABASE_URL=postgres://bevd:bevd@localhost:5432/bevd

# Where the Vue dev server runs. Cookies will not work without this - the browser
# refuses to send credentials to an origin the server has not allowed.
CORS_ORIGIN=http://localhost:5173

# --- Auth ---------------------------------------------------------------------------
# Signs access tokens. At least 32 characters or the app refuses to start.
# Generate one:  openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters

# How long an access token lives. Keep it short: it cannot be revoked before it expires.
JWT_ACCESS_EXPIRY=15m

# Refresh tokens are opaque, stored hashed and revocable, so this can be generous.
REFRESH_TOKEN_TTL_DAYS=7

# Set COOKIE_SECURE=true in production (it requires https). Over plain http in dev a
# Secure cookie is silently dropped by the browser and nothing works.
COOKIE_SECURE=false
# lax | strict | none. "none" requires Secure, and is only for a cross-site frontend.
COOKIE_SAME_SITE=lax

# Which hosts the browser hands the session cookies back to. Empty leaves them
# host-only: only the host that set them gets them back, which is right on
# localhost and where one hostname serves both halves.
#
# Set the shared parent (COOKIE_DOMAIN=example.com) once the app and the API are
# split across hosts, or app.example.com never receives what api.example.com
# set and a login that returned 200 is followed by requests with no session on
# them. A Domain cookie also goes to every subdomain under it, including ones
# you do not run, so pick the narrowest parent that covers your hosts.
COOKIE_DOMAIN=
