{
	"name": "@bevd/backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./trpc": "./src/trpc/routers/index.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"openapi": "bun run src/scripts/openapi.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run src/db/seed.ts"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/openapi": "^1.4.16",
		"@grpc/grpc-js": "^1.14.6",
		"@grpc/proto-loader": "^0.8.1",
		"@trpc/server": "^11.19.0",
		"arktype": "^2.2.8",
		"drizzle-orm": "^0.45.4",
		"elysia": "^1.4.30",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@types/bun": "^1.4.2",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^5.0.3",
		"drizzle-kit": "^0.31.11",
		"vitest": "^5.0.3"
	}
}
