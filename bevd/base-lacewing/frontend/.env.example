# Vite only exposes variables prefixed with VITE_ to the browser.
#   cp .env.example .env

VITE_API_URL=http://localhost:3000

# Point this at another host and the backend needs COOKIE_DOMAIN set to the
# parent both hosts share (see ../backend/.env.example). This app reads the CSRF
# cookie back with document.cookie, and a cookie the API host scoped to itself
# is not readable here, so every mutation fails the double-submit check until
# both are scoped to the parent.
